{
  "name": "dsh-save-button",
  "version": "0.1.3",
  "description": "Download files delivered by `present` straight from the Web GUI delivery card — no SFTP, no extra tools.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "download",
    "deliverables",
    "present"
  ],
  "license": "MIT",
  "author": "hanbernate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanbernate/dsh-save-button.git"
  },
  "homepage": "https://github.com/hanbernate/dsh-save-button#readme",
  "bugs": {
    "url": "https://github.com/hanbernate/dsh-save-button/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "doc",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
